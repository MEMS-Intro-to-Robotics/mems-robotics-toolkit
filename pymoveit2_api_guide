from pymoveit2 import MoveIt2Servo
import time

servo = MoveIt2Servo(
    node=node,
    frame_id="base_link",
    linear_speed=0.1,
    angular_speed=0.5,
    enable_at_init=True,
    callback_group=callback_group,
)

