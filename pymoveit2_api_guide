### Pick and Place with Gripper

```python
from pymoveit2 import MoveIt2, GripperInterface

# Initialize arm and gripper
arm = MoveIt2(...)
gripper = GripperInterface(
    node=node,
    gripper_joint_names=["finger_joint"],
    open_gripper_joint_positions=[0.04],
    closed_gripper_joint_positions=[0.0],
    callback_group=callback_group,
)

# Open gripper
gripper.open()
gripper.wait_until_executed()

# Move to pick position
arm.move_to_pose(position=(0.5, 0.0, 0.1), quat_xyzw=(0.0, 1.0, 0.0, 0.0))
arm.wait_until_executed()

# Close gripper to grasp
gripper.close()
gripper.wait_until_executed()

# Attach object to robot
arm.attach_collision_object("object", touch_links=["finger_link"])

# Move to place position
arm.move_to_pose(position=(0.5, 0.3, 0.2), quat_xyzw=(0.0, 1.0, 0.0, 0.0))
arm.wait_until_executed()

# Open gripper to release
gripper.open()
gripper.wait_until_executed()

# Detach object
arm.detach_collision_object("object")
```

