### Kinematics

#### Forward Kinematics

```python
# Synchronous FK
pose = moveit2.compute_fk(
    joint_state: Optional[Union[JointState, List[float]]] = None,  # Default: current
    fk_link_names: Optional[List[str]] = None,  # Default: end effector
) -> Optional[Union[PoseStamped, List[PoseStamped]]]

# Asynchronous FK
future = moveit2.compute_fk_async(...)
result = moveit2.get_compute_fk_result(future, fk_link_names)
```

#### Inverse Kinematics

```python
# Synchronous IK
joint_state = moveit2.compute_ik(
    position: Union[Point, Tuple[float, float, float]],
    quat_xyzw: Union[Quaternion, Tuple[float, float, float, float]],
    start_joint_state: Optional[Union[JointState, List[float]]] = None,
    constraints: Optional[Constraints] = None,
    wait_for_server_timeout_sec: Optional[float] = 1.0,
) -> Optional[JointState]

# Asynchronous IK
future = moveit2.compute_ik_async(...)
result = moveit2.get_compute_ik_result(future)
```

### Collision Object Management

#### Add Primitive Collision Objects

```python
# Generic primitive (BOX, SPHERE, CYLINDER, CONE)
moveit2.add_collision_primitive(
    id: str,                                   # Unique identifier
    primitive_type: int,                       # SolidPrimitive.BOX/SPHERE/CYLINDER/CONE
    dimensions: Tuple[float, float, float],    # Shape-specific dimensions
    pose: Optional[Union[PoseStamped, Pose]] = None,
    position: Optional[Union[Point, Tuple[float, float, float]]] = None,
    quat_xyzw: Optional[Union[Quaternion, Tuple[float, float, float, float]]] = None,
    frame_id: Optional[str] = None,
    operation: int = CollisionObject.ADD,
)

# Box (dimensions: [x_size, y_size, z_size])
moveit2.add_collision_box(
    id: str,
    size: Tuple[float, float, float],
    pose=None, position=None, quat_xyzw=None, frame_id=None,
    operation: int = CollisionObject.ADD,
)

# Sphere (dimensions: [radius])
moveit2.add_collision_sphere(
    id: str,
    radius: float,
    pose=None, position=None, quat_xyzw=None, frame_id=None,
    operation: int = CollisionObject.ADD,
)

# Cylinder (dimensions: [height, radius])
moveit2.add_collision_cylinder(
    id: str,
    height: float,
    radius: float,
    pose=None, position=None, quat_xyzw=None, frame_id=None,
    operation: int = CollisionObject.ADD,
)

# Cone (dimensions: [height, radius])
moveit2.add_collision_cone(
    id: str,
    height: float,
    radius: float,
    pose=None, position=None, quat_xyzw=None, frame_id=None,
    operation: int = CollisionObject.ADD,
)
```

#### Add Mesh Collision Object

```python
# Requires: pip install trimesh
moveit2.add_collision_mesh(
    filepath: Optional[str],                   # Path to mesh file (STL, OBJ, etc.)
    id: str,
