## Complete Usage Examples

### Basic Arm Motion

```python
import rclpy
from rclpy.node import Node
from rclpy.callback_groups import ReentrantCallbackGroup
from pymoveit2 import MoveIt2

def main():
    rclpy.init()
    node = Node("moveit2_example")
    callback_group = ReentrantCallbackGroup()
    
    # Create MoveIt2 interface
    moveit2 = MoveIt2(
        node=node,
        joint_names=["joint1", "joint2", "joint3", "joint4", "joint5", "joint6"],
        base_link_name="base_link",
        end_effector_name="tool0",
        group_name="arm",
        callback_group=callback_group,
    )
    
    # Configure planning parameters
    moveit2.max_velocity = 0.5
    moveit2.max_acceleration = 0.5
    moveit2.planner_id = "RRTConnect"
    
    # Move to joint configuration
    moveit2.move_to_configuration([0.0, -1.57, 1.57, 0.0, 1.57, 0.0])
    moveit2.wait_until_executed()
    
    # Move to Cartesian pose
    moveit2.move_to_pose(
        position=(0.5, 0.0, 0.4),
        quat_xyzw=(0.0, 0.707, 0.0, 0.707),
    )
    moveit2.wait_until_executed()
    
    # Cartesian path planning
    moveit2.move_to_pose(
        position=(0.5, 0.2, 0.4),
        quat_xyzw=(0.0, 0.707, 0.0, 0.707),
        cartesian=True,
        cartesian_max_step=0.01,
    )
    moveit2.wait_until_executed()
    
    rclpy.shutdown()
```

